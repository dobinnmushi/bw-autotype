#!/usr/bin/python3 -I
"""bw-autotype: GNOME/Wayland で rofi-rbw を呼び出すための薄いラッパー（既定のホットキー Super+Alt+P）。

1. 本人確認（解除済みなら指紋、だめならマスターパスワード。ロック中ならマスターパスワード）。
2. 数分以内に使った項目があれば一覧の先頭に置く（ユーザー名 → 次のページでパスワード、を楽にする）。
   なければ、前面ウィンドウのアプリ名・タイトルから絞り込み語を作る。
3. 一覧の下に、rofi-rbw.rc の keybindings から作ったキー説明（日本語か英語）を出す。
4. 入力の間だけ IBus を素の配列にし、dotool に配列（DOTOOL_XKB_LAYOUT）を渡す。
設定は ~/.config/bw-autotype/config.toml（書式は config/config.example.toml）。
引数はそのまま rofi-rbw に渡す。共通部分は ~/.local/lib/bw-autotype/bwcommon.py。
"""
import html
import json
import os
import re
import subprocess
import sys
import tempfile
import threading
import unicodedata

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import bwcommon as bw  # noqa: E402

# 絞り込み語の候補から外す語（ブラウザ名など、どの項目にも当たりうる語）
STOPWORDS = {"mozilla", "firefox", "google", "chrome", "chromium", "brave", "org", "com", "www", "net", "the", "and",
             "new", "tab", "page", "gnome", "ubuntu", "snap", "app", "desktop"}
DEFAULT_KEYBINDINGS = ("Alt+1:type:username:tab:password,Alt+2:type:username,Alt+3:type:password,"
                       "Alt+4:type:totp,Alt+c:copy:password,Alt+u:copy:username,Alt+t:copy:totp,"
                       "Alt+m::menu,Alt+s:sync")


# ---- 前面ウィンドウに合う項目 ----
def vault_items():
    r = bw.run(["rbw", "list", "--raw"])
    try:
        return json.loads(r.stdout) if r.returncode == 0 else []
    except ValueError:
        return []


def site_matches(win, items):
    """前面のウィンドウに合う項目と、rofi の絞り込み欄に入れる語。(項目のリスト, 語)。

    ブラウザならアドレスバーのドメインを名前・URI に含む項目、それ以外は題名・アプリ名の語のうち
    項目の名前・ユーザー名・フォルダに含まれる最初の語で選ぶ。
    """
    if bw.browser_app(win):
        host = bw.browser_host(win)
        if host:
            dom = bw.base_domain(host)
            by_name = [i for i in items if dom in (i.get("name") or "").lower()]
            by_uri = [i for i in items if any(dom in (u or "").lower() for u in (i.get("uris") or []))]
            if by_name:
                return by_name + [i for i in by_uri if i not in by_name], dom
            names = {i.get("name") for i in by_uri}
            if by_uri:
                # rofi は表示中の名前に対して絞るので、名前が1つにまとまるときだけ名前を語にする
                return by_uri, names.pop() if len(names) == 1 else ""

    words = re.findall(r"\w+", f"{bw.page_title(win)} {win.get('wm_class', '').split('.')[-1]}".lower())
    for w in words:
        if len(w) < 3 or w in STOPWORDS:
            continue
        hits = [i for i in items
                if w in " ".join(str(i.get(k) or "") for k in ("name", "user", "folder")).lower()]
        if hits:
            return hits, w
    return [], ""


def write_items(items):
    """項目の (フォルダ, 名前, ユーザー名, 種類) を STATE_DIR のファイルに書き、そのパスを返す（秘密は含まない）"""
    os.makedirs(bw.STATE_DIR, mode=0o700, exist_ok=True)
    path = os.path.join(bw.STATE_DIR, "items.json")
    with open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w", encoding="utf-8") as f:
        json.dump([[*item_key(i), i.get("type")] for i in items], f)
    return path


def item_key(i):
    return [i.get("folder") or "", i.get("name") or "", i.get("user") or ""]


# ---- キー説明 ----
TARGET_NAMES = {"username": bw.tr("ユーザー名", "username"), "password": bw.tr("パスワード", "password"),
                "totp": bw.tr("ワンタイムコード", "one-time code"), "notes": bw.tr("メモ", "notes"),
                "cardholder": bw.tr("カード名義", "cardholder name"),
                "tab": "Tab", "enter": "Enter", "delay": bw.tr("（待つ）", "(wait)")}


def width(s):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def pad(s, n):
    return s + " " * max(0, n - width(s))


def read_keybindings():
    try:
        with open(bw.RC_FILE, encoding="utf-8") as f:
            for line in f:
                m = re.match(r"\s*keybindings\s*[=:]\s*(.+)", line)
                if m:
                    return m.group(1).strip()
    except OSError:
        pass
    return DEFAULT_KEYBINDINGS


def sync_key():
    """rofi-rbw.rc の keybindings で同期に割り当てたキー（なければ空）"""
    for kb in read_keybindings().split(","):
        parts = kb.strip().split(":")
        if len(parts) >= 2 and parts[1] == "sync":
            return parts[0]
    return ""


def help_rows():
    """キー説明の中身: ({見出し: [(キー, 説明)]}, 最後の1行)。"""
    typing, copying, other = bw.tr("入力", "Type"), bw.tr("コピー", "Copy"), bw.tr("その他", "Other")
    groups = {typing: [], copying: [], other: []}
    for kb in read_keybindings().split(","):
        parts = kb.strip().split(":")
        if len(parts) < 2:
            continue
        key, action, targets = parts[0], parts[1], [t for t in parts[2:] if t]
        if "menu" in targets:
            groups[other].append((key, bw.tr("中身を選んで入力", "choose what to type")))
        elif action == "sync":
            groups[other].append((key, bw.tr("同期", "sync")))
        elif action in ("type", "copy"):
            names = [TARGET_NAMES.get(t, t) for t in targets]
            if action == "copy" or len(names) > 1:
                label = "→".join(names)
            else:
                label = bw.tr(f"{names[0]}だけ", f"{names[0]} only") if names else bw.tr("既定の中身", "default")
            if action == "type" and targets == ["username", "tab", "password"]:
                key = f"Enter/{key}"
            groups[typing if action == "type" else copying].append((key, label))
    if not any(k.startswith("Enter") for k, _ in groups[typing]):
        groups[typing].insert(0, ("Enter", "→".join(TARGET_NAMES[t] for t in ("username", "tab", "password"))))
    secs = int(bw.CONFIG["autotype"]["clear_clipboard_seconds"])
    if groups[copying] and secs > 0:
        groups[copying].append(("", bw.tr(f"（{secs}秒後に消える）", f"(cleared after {secs}s)")))
    groups[other].append(("Esc", bw.tr("閉じる", "close")))
    groups[other].append((bw.hotkey_label(bw.CONFIG["hotkeys"]["new"]), bw.tr("新規登録", "new login")))
    last = bw.tr("カード Enter: 番号→Tab→期限→Tab→コード（1項目ずつは Alt+m）   個人情報 Enter: 中身を選ぶ",
                 "Card Enter: number→Tab→expiry→Tab→code (one field: Alt+m)   Identity Enter: choose a field")
    return {k: v for k, v in groups.items() if v}, last


def help_message():
    """一覧の下に出すキー説明（pango マークアップ）。autotype.help が full なら列に並べ、line なら1行、none なら出さない。"""
    mode = bw.CONFIG["autotype"]["help"]
    if mode == "none":
        return None
    groups, last = help_rows()
    dim = "<span foreground='#a0a0a0'>{}</span>"
    if mode == "line":
        return "  ".join(f"<b>{html.escape(k)}</b> {html.escape(label)}"
                         for rows in groups.values() for k, label in rows if k and k != "Esc")

    # 見出し・キー・説明を1つの列とし、列を横に並べる
    columns = []
    for head, rows in groups.items():
        keyw = max(width(k) for k, _ in rows)
        cells = [(pad(head if i == 0 else "", width(head)), pad(k, keyw), label) for i, (k, label) in enumerate(rows)]
        colw = max(width(h) + 1 + keyw + 1 + width(label) for h, _, label in cells)
        columns.append((cells, colw))
    height = max(len(cells) for cells, _ in columns)
    lines = []
    for r in range(height):
        parts = []
        for cells, colw in columns:
            if r < len(cells):
                h, k, label = cells[r]
                text = f"{h} {k} {label}"
                parts.append(dim.format(html.escape(h)) + f" <b>{html.escape(k)}</b> {html.escape(label)}"
                             + " " * (colw - width(text) + 3))
            else:
                parts.append(" " * (colw + 3))
        lines.append("".join(parts).rstrip())
    lines.append(dim.format(html.escape(last)))
    return "\n".join(lines)


# ---- 本体 ----
def remember_used(before):
    """一覧で選ばれた項目（rofi-rbw が回数を増やした行）を記録する。選ばれなければ何もしない。"""
    old = {h: n for _, h, n in before}
    changed = [h for _, h, n in bw.read_runcache() if old.get(h) != n]
    if len(changed) == 1:
        bw.remember(changed[0])


def prepare(win):
    """一覧を出すための下ごしらえ: (保管庫の項目, 合う項目, rofi 用の語)。保管庫がロック中なら項目は空"""
    bw.sync_if_stale()
    items = vault_items()
    matches, term = site_matches(win, items)
    return items, matches, term


def main():
    win = bw.focused_window()
    # 指紋を待つあいだに、保管庫の一覧を読み、前面のページに合う項目を探しておく
    prep = {}
    worker = threading.Thread(target=lambda: prep.update(result=prepare(win)), daemon=True)
    worker.start()
    if not bw.authorize():
        bw.notify(bw.tr("中止しました（本人確認ができませんでした）", "Cancelled (could not verify your identity)"))
        return 1
    worker.join()
    items, matches, term = prep.get("result") or ([], [], "")
    if not items:
        items, matches, term = prepare(win)    # ロック中だったなどで読めていなければ、開いたあとで読み直す

    mesg = help_message()
    extra = ["-mesg", mesg] if mesg else []
    h = bw.recent_hash()
    recent_first = bool(h and bw.put_first(h, bw.read_runcache()))
    env_extra = {"BW_AUTOTYPE_TARGET_WIN": str(win.get("id") or "")}
    if os.path.exists(os.environ.get("BWVAULT_GATE_SOCKET", "/run/bwvault-gate/gate.sock")):
        # bw-vault（保管庫の鍵を別ユーザーに置く門）があるとき: ユーザー名だけを入力・コピーする操作では、秘密を除いた項目を取らせる
        # （門が、項目の確認を出さずに済む）。rofi-rbw のフォーク（ROFI_RBW_FETCH_PUBLIC に対応）だけが読み、知らない版は無視する
        env_extra["ROFI_RBW_FETCH_PUBLIC"] = "1"
    if bw.CONFIG["autotype"]["selector"] == "rofi":
        # rofi: 直前の項目がなければ、合う語を絞り込み欄に入れる
        if term and not recent_first:
            extra += ["-filter", term]
    else:
        # 自作の一覧: 合う項目を上に並べて印を付ける（直前の項目はさらにその上）。キー説明は表にして出す
        env_extra["BW_AUTOTYPE_SITE"] = json.dumps([item_key(i) for i in matches])
        # 一覧の画面が rbw list をもう一度呼ばずに済むよう、項目の種類を自分しか読めないファイルで渡す
        env_extra["BW_AUTOTYPE_ITEMS"] = write_items(items)
        env_extra["BW_AUTOTYPE_SYNC_KEY"] = sync_key()
        env_extra["BW_AUTOTYPE_RECENT"] = "1" if recent_first else ""
        if mesg:
            groups, last = help_rows()
            env_extra["BW_AUTOTYPE_HELP"] = json.dumps({"mode": bw.CONFIG["autotype"]["help"],
                                                        "groups": list(groups.items()), "last": last})
            extra = []
    before = bw.read_runcache()

    layout = bw.detect_layout()
    env = dict(bw.dotool_env(*layout), BW_AUTOTYPE_ROFI_EXTRA=json.dumps(extra), **env_extra)
    # rofi-rbw の標準エラーは、パイプではなく一時ファイルで受ける。パイプだと、rofi-rbw が起動した常駐のプロセス
    # （貼り付けに応える wl-copy など）がパイプを引き継いだとき、それが終わるまで、ここで待ち続けてしまう
    with tempfile.TemporaryFile() as errfile:
        with bw.plain_ime(*layout):
            rc = subprocess.run(["rofi-rbw", *sys.argv[1:]], env=env, stderr=errfile).returncode
        errfile.seek(0)
        raw = errfile.read().decode(errors="replace")
    err = raw.strip()
    if err:
        sys.stderr.write(raw)              # 端末から手で動かしたときは、これまでどおり見える
    if rc != 0 or err:
        # 「何も起きない」ときの原因を、記録に残す（rofi-rbw の終了コードと、標準エラーの末尾。認証情報は含まれない）
        bw.log(f"rofi-rbw: exit {rc}" + (f", stderr: {err[-400:]!r}" if err else ""))
    remember_used(before)
    return rc


if __name__ == "__main__":
    sys.exit(main())
